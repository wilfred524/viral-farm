# === Telegram (Fase 2) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# === IA ===
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5   # modelo para selección de episodios y guion
# Respuestas del LLM en disco: se leen en vez de llamar a la API (y se cachean cuando sí se
# llama). Permite ejercitar el pipeline sin clave, con la misma validación de esquema.
LLM_RESPUESTAS_DIR=
OPENAI_API_KEY=            # opcional: TTS
ELEVENLABS_API_KEY=        # opcional: TTS premium

# === Idiomas ===
# IDIOMA_FUENTE: el que se habla en el video. `auto` deja que Whisper lo detecte, que es lo
# recomendable: forzar un idioma equivocado no da error, devuelve una transcripción traducida
# a medias e inservible.
IDIOMA_FUENTE=auto         # auto | es | en | pt | fr | it | de …
# IDIOMA_SALIDA: idioma de narración, hook, caption y hashtags. Vacío = el mismo del audio.
# Se fija para producir contenido en otro idioma (película en inglés → clips en español).
IDIOMA_SALIDA=

# === Transcripción (faster-whisper) ===
WHISPER_MODELO=small       # tiny | base | small | medium | large-v3
WHISPER_DISPOSITIVO=cpu    # cuda requiere cuBLAS/cuDNN instalados

# === Voz (Edge-TTS) ===
# Vacío = la voz del catálogo para el idioma de salida (src/lib/idiomas.ts). Fijarla la impone
# en todos los idiomas. `edge-tts --list-voices` lista las disponibles.
TTS_VOZ=

# === Publicación (intermediario, Fase 3) ===
PUBLISHER_PROVIDER=        # upload-post | blotato | metricool
PUBLISHER_API_KEY=

# === n8n (Fase 2) ===
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# === Formato serie ===
# Llamadas a la acción del caption. Vacío = las del catálogo de idiomas, en el idioma de salida.
SERIE_CTA=
SERIE_CTA_FINAL=

# === Render ===
RENDER_CRF=23              # 18 (default de Remotion) duplica tamaño y tiempo sin ganancia visible
RENDER_PRESET=faster       # faster | fast | medium
RENDER_CONCURRENCIA=       # vacío = heurística de Remotion; subirlo acelera en máquinas con 8+ núcleos

# === Rutas locales y montaje ===
MEDIA_DIR=./media          # workspace de artefactos; puede apuntar a otro disco
FFMPEG_PATH=               # vacío = el ffmpeg del PATH (nunca el bundled de Remotion)
PYTHON_PATH=               # vacío = el python del PATH
DUCKING_DB=-18             # atenuación del audio ambiental bajo la narración
MIN_GB_LIBRES=8            # el render aborta si hay menos espacio libre
